{
  "name": "@gridboard/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:compose": "vitest run compose-boot",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:generate:sqlite": "OPSX_DIALECT=sqlite drizzle-kit generate",
    "migrate:sqlite": "OPSX_DIALECT=sqlite drizzle-kit migrate",
    "db:reset": "node -e \"import('node:fs').then(fs=>{fs.rmSync('./local.db',{force:true});fs.rmSync('./local.db-shm',{force:true});fs.rmSync('./local.db-wal',{force:true})})\" && DATABASE_URL=sqlite:./local.db OPSX_DIALECT=sqlite drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/lib-storage": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.3.0",
    "@gridboard/domain": "workspace:*",
    "@hocuspocus/extension-database": "^2.15.3",
    "@hocuspocus/server": "^2.15.3",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.22.0",
    "ws": "^8.21.1",
    "yjs": "^13.6.31",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
