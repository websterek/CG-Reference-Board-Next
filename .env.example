# GridBoard environment variables (development defaults)
# Copy to .env and adjust as needed.

# --- Database ---
DATABASE_URL=postgres://gridboard:gridboard@localhost:5432/gridboard

# --- Auth ---
# Generate a secure secret for production: `openssl rand -hex 64`
JWT_SECRET=dev-only-jwt-secret-change-me-please-change-me-in-production-please-please-please
JWT_EXPIRES_IN=30d

# --- Storage backend (minio | local) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gridboard-assets
S3_FORCE_PATH_STYLE=true

# --- Hocuspocus / Yjs ---
HOCUSPOCUS_FLUSH_INTERVAL_MS=2000
HOCUSPOCUS_PORT=3000

# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
