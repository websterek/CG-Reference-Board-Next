{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "share": "disabled",
  "snapshot": true,
  "mcp": {
    "context7": {
      "enabled": true
    },
    "websearch": {
      "enabled": true
    },
    "grep_app": {
      "enabled": true
    },
    "gitnexus": {
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 30000
  },
  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 40000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4
  }
}
